{
  "name": "tela-compartilhada",
  "version": "1.0.0",
  "description": "Compartilhar uma janela + só o áudio dela",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "dependencies": {
    "peerjs": "1.5.4"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "tela.compartilhada",
    "productName": "TelaCompartilhada",
    "files": [
      "src/**",
      "node_modules/peerjs/dist/**"
    ],
    "extraResources": [
      {
        "from": "native/audio-app.exe",
        "to": "audio-app.exe"
      }
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "TelaCompartilhada.exe"
    }
  }
}
