{
  "name": "tela-compartilhada",
  "version": "1.0.0",
  "description": "Compartilhar uma janela + só o áudio dela",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "peerjs": "1.5.4"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "tela.compartilhada",
    "productName": "TelaCompartilhada",
    "files": [
      "src/**",
      "build/icon.png",
      "node_modules/peerjs/dist/**"
    ],
    "extraResources": [
      {
        "from": "native/audio-app.exe",
        "to": "audio-app.exe"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Tela Compartilhada",
      "artifactName": "TelaCompartilhada-Setup.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Tela Compartilhada"
    }
  }
}
